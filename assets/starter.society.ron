(
    needs: [
        (id: "social", decay_per_day: 1.0),
        (id: "rest", decay_per_day: 0.7),
        (id: "food", decay_per_day: 0.9),
        (id: "fun", decay_per_day: 0.8),
    ],
    topics: [
        (id: "kindness"),
        (id: "honesty"),
    ],
    deeds: [
        (id: "help", topic: "kindness", harm: 0.5),
        (id: "gift", topic: "kindness", harm: 0.6),
        (id: "insult", topic: "kindness", harm: -0.4),
        (id: "steal", topic: "honesty", harm: -0.7),
    ],
    activities: [
        (
            id: "sleep",
            target: Home,
            duration_hours: 8.0,
            rank: 1,
            considerations: [
                (input: Hour, curve: Hours(22.0, 6.0)),
                (input: Need("rest"), curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("rest", 0.15)],
            interaction: None,
            barks: [],
        ),
        (
            id: "eat",
            target: Place("food"),
            duration_hours: 0.75,
            considerations: [
                (input: Need("food"), curve: Logistic(-10.0, 0.35)),
            ],
            satisfies: [("food", 1.2)],
            interaction: None,
            barks: ["Mmm, bread."],
        ),
        (
            id: "work",
            target: Place("work"),
            duration_hours: 4.0,
            considerations: [
                (input: Hour, curve: Hours(8.0, 17.0)),
            ],
            satisfies: [],
            interaction: None,
            barks: ["Back to it."],
        ),
        (
            id: "chat",
            target: Person,
            duration_hours: 0.3,
            considerations: [
                (input: Need("social"), curve: Linear(-1.0, 1.0)),
                (input: Affinity, curve: Linear(0.8, 0.4)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("social", 1.2)],
            interaction: Some("chat"),
            barks: [],
        ),
        (
            id: "gossip",
            target: Person,
            duration_hours: 0.3,
            // Gossip and chat serve the same need, so they starve each other unless one is gated.
            // The gate is having something to say: a villager with no rumor it is still spreading
            // scores 0 here and chats instead. That is the mechanism the literature names — gossip
            // carries reputation *information* (Sommerfeld et al. 2007) — and it is why `chat` was
            // reachable at 1:1.7 in the village but starved at 1:24 in a cluster of strangers who
            // had nothing else to spread.
            considerations: [
                (
                    input: Script("if ctx.tellable(actor) { 1.0 } else { 0.0 }"),
                    curve: Linear(1.0, 0.0),
                ),
                (input: Trait(Extraversion), curve: Linear(1.0, 0.0)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("social", 1.0)],
            interaction: Some("gossip"),
            barks: [],
        ),
        (
            id: "play",
            target: Person,
            duration_hours: 0.5,
            considerations: [
                // Cheap to reach, like `chat`: the other person walks to the actor, so a use costs half
                // an hour rather than a walk plus a sitting. That is the whole difference from `relax`,
                // which has the same purpose but costs a walk and an evening window — measured, a person
                // got 0.10 of the 1.33 `relax`es a day that `fun`'s decay demanded.
                //
                // Intrinsic motivation arises in need-supportive social contexts rather than in
                // solitude: Vansteenkiste & Ryan 2013 (DOI 10.1037/a0032359) on self-determination
                // theory. Playing *with* someone is the social form of leisure.
                (input: Need("fun"), curve: Linear(-1.0, 1.0)),
                (input: Affinity, curve: Linear(0.0, 0.8)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            // `satisfies` is a per-game-hour rate paid for the whole duration, so 1.7 x 0.5 h = 0.85 per
            // use against `fun`'s 0.8/day: one session covers a day. Design default, sized to the decay
            // the same way `relax`'s rate has to be, and no paper gives the number.
            satisfies: [("fun", 1.7), ("social", 0.3)],
            interaction: Some("chat"),
            barks: ["Ha!"],
        ),
        (
            id: "compliment",
            target: Person,
            duration_hours: 0.2,
            considerations: [
                (input: Affinity, curve: Logistic(8.0, 0.7)),
            ],
            satisfies: [],
            interaction: Some("compliment"),
            barks: [],
        ),
        (
            id: "snub",
            target: Person,
            duration_hours: 0.1,
            considerations: [
                // A grudge, not low affinity. People snub those they have a reason to resent, not
                // strangers they barely know: gating on `Affinity Logistic(-8, 0.3)` meant the
                // village snubbed only people it had not yet befriended, so a society that talks
                // kindly to everyone could never form a rivalry. Measured over 4200 ticks the
                // village chose `snub` for 0 person-ticks; a cluster of strangers chose it for 2583.
                //
                // Bondü & Richter 2016 (DOI 10.3389/fpsyg.2016.00795) is the mechanism: rejection
                // and provocation sensitivity predict reactive aggression — a reaction to how one
                // has been treated, which is exactly `Memories::grudge`.
                (input: Script("ctx.grudge(actor, target)"), curve: Linear(1.0, 0.0)),
            ],
            satisfies: [],
            interaction: Some("insult"),
            barks: [],
        ),
        (
            id: "relax",
            target: Place("gathering"),
            duration_hours: 1.5,
            considerations: [
                (input: Hour, curve: Hours(17.0, 23.0)),
                (input: Need("fun"), curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("fun", 0.4), ("social", 0.2)],
            interaction: None,
            barks: ["Ahh."],
        ),
        (
            id: "wander",
            target: Wander(6.0),
            duration_hours: 0.5,
            weight: 0.05,
            considerations: [],
            satisfies: [],
            interaction: None,
            barks: [],
        ),
    ],
    interactions: [
        (
            id: "chat",
            // **An accepted conversation is an appraisal.** It used to pay `social` to both people and
            // nothing to either one's mood, so 43% of accepted interactions in the village were
            // affectively silent — and they are the most common 43%. Measured over 20 000 ticks: 1 216
            // refusals produced exactly 1 216 distress appraisals while 1 338 acceptances produced 443
            // positive ones, because only `compliment` gave Joy and only to its target.
            //
            // `Liking` rather than `Joy`: OCC's joy is a *prospect* emotion about an event, and what a
            // conversation gives is liking for the person one had it with. Cacioppo, Cacioppo & Gollan
            // 2013 (DOI 10.1017/S0140525X13002537) give the negative channel the steeper gain, so this
            // is modest against an insult's `Anger 0.5` — a bias, not a silence.
            on_accept: (
                actor_needs: [("social", 0.2)],
                target_needs: [("social", 0.2)],
                actor_emotion: Some((Liking, 0.2)),
                target_emotion: Some((Liking, 0.2)),
            ),
            // A refusal is not an injury: the pack used to give it no outcome of its own, so the only
            // emotional consequence of being turned away was the crate's rejection distress — measured,
            // half of all the village's negativity. A refused greeting is mildly deflating, not a small
            // tragedy, and it is the definition's business to say so (OCC's *reproach*, mild).
            on_reject: (actor_emotion: Some((Distress, 0.1))),
            influence: ["kindness", "honesty"],
            barks: (
                actor: ["Morning, {target}!"],
                accepted: ["Good to see you, {target}."],
                rejected: ["Not now."],
            ),
        ),
        (
            id: "gossip",
            on_accept: (
                actor_needs: [("social", 0.15)],
                target_needs: [("social", 0.15)],
                // Listening to gossip is mildly agreeable for both: the teller is heard and the
                // listener is entertained. Same reasoning as `chat`.
                actor_emotion: Some((Liking, 0.15)),
                target_emotion: Some((Liking, 0.15)),
            ),
            on_reject: (actor_emotion: Some((Distress, 0.1))),
            gossip: true,
            barks: (
                actor: ["Did you hear about {subject}?"],
                accepted: ["Really? Tell me more."],
                rejected: ["I'd rather not."],
            ),
        ),
        (
            id: "compliment",
            on_accept: (
                target_to_actor: (affinity: 0.1),
                target_emotion: Some((Joy, 0.3)),
            ),
            barks: (
                actor: ["You look well, {target}."],
                accepted: ["Thank you!"],
                rejected: ["Hmm."],
            ),
        ),
        (
            id: "insult",
            on_accept: (target_emotion: Some((Anger, 0.5))),
            deed: Some("insult"),
            barks: (
                actor: ["Keep your distance, {target}."],
                accepted: ["How dare you!"],
                rejected: ["Hmph."],
            ),
        ),
    ],
)
