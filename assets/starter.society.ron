(
    needs: [
        (id: "social", decay_per_day: 1.0),
        (id: "rest", decay_per_day: 0.7),
        (id: "food", decay_per_day: 0.9),
        (id: "fun", decay_per_day: 0.8),
    ],
    // **A skill is a worker's endowment; a task is a unit of work.**
    //
    // Acemoglu & Autor 2010 (`10.3386/w16082`): "a task is a unit of work activity that produces output
    // ... a skill is a worker's endowment of capabilities for performing various tasks". A skill's level is
    // read from one personality trait, so it needs no stored state: two people with the same
    // conscientiousness are equally good at the same craft, and nobody carries a skill vector to save.
    // The three groups are the crate's own choice (a design default) — no paper assigns traits to trades.
    // **Goods are quantities, not currency.** "Meat and honey are meticulously shared among the Ache, but
    // goods purchased by money are not" — Henrich et al. 2005 (`10.1017/S0140525X05000142`). There is no
    // money and no exchange rate here: a good is a level a person holds, and the price is an observation of
    // what the village produced against what it ate.
    goods: [
        (id: "bread"),
    ],
    skills: [
        (id: "craft", group: Craft),
        (id: "invention", group: Creative),
        (id: "dealings", group: Social),
    ],
    topics: [
        (id: "kindness"),
        (id: "honesty"),
    ],
    deeds: [
        (id: "help", topic: "kindness", harm: 0.5),
        (id: "gift", topic: "kindness", harm: 0.6),
        (id: "insult", topic: "kindness", harm: -0.4),
        (id: "steal", topic: "honesty", harm: -0.7),
    ],
    activities: [
        (
            // **The producer, and the first division of labour.** A task that makes a good, so the store
            // moves and the price has something to be an observation of.
            //
            // It lives in the **starter** pack, not only in the village example, because `eat` here
            // consumes `bread` and a pack that consumes a good it never makes can never feed anybody.
            // That was invisible while an activity's `satisfies` was paid in full whatever its `consumes`
            // found; now that a meal pays for what it took, `eat` in a village that cannot bake is a need
            // nobody can meet. `warn_unmade_goods` says so at startup for any host that hits it.
            //
            // **Four loaves a bake, measured.** A meal is a quarter loaf (`eat`'s own `consumes`) and a
            // village feeds about 3.6 meals a person a game-day once hunger is real, so it wants roughly
            // `people / 3.6 / 4` loaves — a shade under **one a head a day**, which is also what
            // `Tuning::price_full_store` calls a full store, so the two defaults agree.
            //
            // Three and six were measured at two populations and each fails differently. At **3** the
            // supply is 8.7 loaves against 14.8 needed at 16 people: `food` 0.271 with 26.5% of ticks
            // below 0.1. At **6** the village oversupplies — 1.67 loaves a head, the price at the
            // *full-store* value 0.50 on 62% of ticks — and the social fabric goes with it (friends
            // 26 -> 21, rumor reach 0.42 -> 0.25) as sharing swallows the day (29 -> 140 shares). At
            // **4**: `food` 0.339 / 0.330 at 24 and 16 people against the old paid-in-full 0.450 / 0.416,
            // price 0.841 / 0.895 and never at the floor, friends 26 / 20 against 26 / 16. A design
            // default: no paper gives loaves a bake. `docs/loop/runs/2026-10-26-12/`.
            //
            // **The supply does not scale with the population, and that is the trap.** Bakes a game-day
            // are 3.3 at 16 people and 3.9 at 24, because the dawn window is one hour long and the count
            // of people who fit an errand into it is what limits it; loaves a bake 3 -> 6 barely moved
            // bakes a day (3.28 -> 3.91). A host scaling its population must scale `produces` too.
            id: "bake",
            target: Place("food"),
            duration_hours: 1.0,
            produces: [("bread", 4.0)],
            // **A dawn errand, not a second job.** At `Hours(6, 18)` and 2 hours a bake, it out-competed
            // `work` for the whole day and the village lost its rivalries entirely (seed 7: 26 -> 1, seed
            // 42: 33 -> 0, measured). An hour at first light sits where `work`'s `Hours(8, 17)` window is
            // shut, so it adds a morning without taking the day.
            considerations: [
                (input: Hour, curve: Hours(6.0, 7.0)),
                (input: Skill("craft"), curve: Linear(1.0, 0.0)),
            ],
            satisfies: [],
            interaction: None,
            barks: ["Fresh loaves."],
        ),
        (
            id: "sleep",
            target: Home,
            duration_hours: 8.0,
            rank: 1,
            considerations: [
                (input: Hour, curve: Hours(22.0, 6.0)),
                (input: Need("rest"), curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("rest", 0.15)],
            interaction: None,
            barks: [],
        ),
        (
            id: "eat",
            target: Place("food"),
            duration_hours: 0.75,
            considerations: [
                (input: Need("food"), curve: Logistic(-10.0, 0.35)),
            ],
            satisfies: [("food", 1.2)],
            // **Eating uses up bread when there is any, and a meal is a QUARTER of a loaf.**
            //
            // *When there is any*: the store changes what a person prefers, never what they may do —
            // gating a dominant activity on a new condition was measured to wreck the village (rivals
            // 29 -> 55 at seed 42). What an empty shelf costs is the `satisfies` payout, which is scaled
            // by what `consumes` actually found, so a meal from an empty larder walks to the table and
            // restores no `food`. The failure is priced, never prevented.
            //
            // *A quarter*: a bake is four loaves and a meal used to ask for a **whole** one, which the
            // village could never supply. Measured at seed 23 (24 people, 17.62 game-days) it bakes 4
            // loaves a game-day and takes 21 meals, so the store was empty on **23.2%** of ticks and
            // `food` sat at 0.450 only because every one of those meals was paid in full anyway. At a
            // quarter loaf the village holds bread on all but **3.8%** of ticks and `food` reads 0.339 —
            // and 110 loaves change hands where 29 did. A loaf is several servings and the pack never
            // said how many; a quarter is a design default. `docs/loop/runs/2026-10-26-12/`.
            consumes: [("bread", 0.25)],
            interaction: None,
            barks: ["Mmm, bread."],
        ),
        (
            id: "work",
            target: Place("work"),
            duration_hours: 4.0,
            // Work is a **task** for the craft skill: a diligent person gets more out of the same hours.
            // Nothing is gated — an idle person can still choose to work, at a lower score, which is
            // comparative advantage rather than assignment.
            profession: Some("craft"),
            considerations: [
                (input: Hour, curve: Hours(8.0, 17.0)),
            ],
            satisfies: [],
            interaction: None,
            barks: ["Back to it."],
        ),
        (
            id: "chat",
            target: Person,
            duration_hours: 0.3,
            considerations: [
                (input: Need("social"), curve: Linear(-1.0, 1.0)),
                (input: Affinity, curve: Linear(0.8, 0.4)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("social", 1.2)],
            interaction: Some("chat"),
            barks: [],
        ),
        (
            id: "gossip",
            target: Person,
            duration_hours: 0.3,
            // Gossip and chat serve the same need, so they starve each other unless one is gated.
            // The gate is having something to say: a villager with no rumor it is still spreading
            // scores 0 here and chats instead. That is the mechanism the literature names — gossip
            // carries reputation *information* (Sommerfeld et al. 2007) — and it is why `chat` was
            // reachable at 1:1.7 in the village but starved at 1:24 in a cluster of strangers who
            // had nothing else to spread.
            considerations: [
                (
                    input: Script("if ctx.tellable(actor) { 1.0 } else { 0.0 }"),
                    curve: Linear(1.0, 0.0),
                ),
                (input: Trait(Extraversion), curve: Linear(1.0, 0.0)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("social", 1.0)],
            interaction: Some("gossip"),
            barks: [],
        ),
        (
            id: "play",
            target: Person,
            duration_hours: 0.5,
            considerations: [
                // Cheap to reach, like `chat`: the other person walks to the actor, so a use costs half
                // an hour rather than a walk plus a sitting. That is the whole difference from `relax`,
                // which has the same purpose but costs a walk and an evening window — measured, a person
                // got 0.10 of the 1.33 `relax`es a day that `fun`'s decay demanded.
                //
                // Intrinsic motivation arises in need-supportive social contexts rather than in
                // solitude: Vansteenkiste & Ryan 2013 (DOI 10.1037/a0032359) on self-determination
                // theory. Playing *with* someone is the social form of leisure.
                (input: Need("fun"), curve: Linear(-1.0, 1.0)),
                (input: Affinity, curve: Linear(0.0, 0.8)),
                (input: Distance, curve: Linear(-1.0, 1.0)),
            ],
            // `satisfies` is a per-game-hour rate paid for the whole duration, so 1.7 x 0.5 h = 0.85 per
            // use against `fun`'s 0.8/day: one session covers a day. Design default, sized to the decay
            // the same way `relax`'s rate has to be, and no paper gives the number.
            satisfies: [("fun", 1.7), ("social", 0.3)],
            interaction: Some("chat"),
            barks: ["Ha!"],
        ),
        (
            id: "compliment",
            target: Person,
            duration_hours: 0.2,
            considerations: [
                (input: Affinity, curve: Logistic(16.0, 0.25)),
            ],
            satisfies: [],
            interaction: Some("compliment"),
            barks: [],
        ),
        (
            id: "snub",
            target: Person,
            duration_hours: 0.1,
            considerations: [
                // A grudge, not low affinity. People snub those they have a reason to resent, not
                // strangers they barely know: gating on `Affinity Logistic(-8, 0.3)` meant the
                // village snubbed only people it had not yet befriended, so a society that talks
                // kindly to everyone could never form a rivalry. Measured over 4200 ticks the
                // village chose `snub` for 0 person-ticks; a cluster of strangers chose it for 2583.
                //
                // Bondü & Richter 2016 (DOI 10.3389/fpsyg.2016.00795) is the mechanism: rejection
                // and provocation sensitivity predict reactive aggression — a reaction to how one
                // has been treated, which is exactly `Memories::grudge`.
                (input: Script("ctx.grudge(actor, target)"), curve: Linear(1.0, 0.0)),
            ],
            satisfies: [],
            interaction: Some("insult"),
            barks: [],
        ),
        (
            id: "relax",
            target: Place("gathering"),
            duration_hours: 1.5,
            considerations: [
                (input: Hour, curve: Hours(17.0, 23.0)),
                (input: Need("fun"), curve: Linear(-1.0, 1.0)),
            ],
            satisfies: [("fun", 0.4), ("social", 0.2)],
            interaction: None,
            barks: ["Ahh."],
        ),
        (
            id: "wander",
            target: Wander(6.0),
            duration_hours: 0.5,
            weight: 0.05,
            considerations: [],
            satisfies: [],
            interaction: None,
            barks: [],
        ),
    ],
    interactions: [
        (
            id: "chat",
            // **An accepted conversation is an appraisal.** It used to pay `social` to both people and
            // nothing to either one's mood, so 43% of accepted interactions in the village were
            // affectively silent — and they are the most common 43%. Measured over 20 000 ticks: 1 216
            // refusals produced exactly 1 216 distress appraisals while 1 338 acceptances produced 443
            // positive ones, because only `compliment` gave Joy and only to its target.
            //
            // `Liking` rather than `Joy`: OCC's joy is a *prospect* emotion about an event, and what a
            // conversation gives is liking for the person one had it with. Cacioppo, Cacioppo & Gollan
            // 2013 (DOI 10.1017/S0140525X13002537) give the negative channel the steeper gain, so this
            // is modest against an insult's `Anger 0.5` — a bias, not a silence.
            on_accept: (
                actor_needs: [("social", 0.2)],
                target_needs: [("social", 0.2)],
                actor_emotion: Some((Liking, 0.2)),
                target_emotion: Some((Liking, 0.2)),
                // **Trust has to be able to rise.** `AcceptDef` centres it on 0.5 and `Tie::new` starts
                // there, so a village where nothing raises it drifts below neutral and the term subtracts
                // from every acceptance draw. Nothing in this pack set a `TieDelta::trust` at all; the only
                // mover was `witness_reaction`'s `trust_gain * harm`, which is negative for a deed. Measured,
                // mean trust at the moment of an exchange was **0.261** and **47% of interactions were
                // refused**. A conversation that goes well is how people come to trust each other.
                // 0.05, not 0.02. A witnessed `steal` moves trust by `witness_gain * harm` =
                // `0.2 * -0.7` = **-0.14**, so at 0.02 one bad deed undid seven good conversations and
                // the village's trust could only fall. Matching the deed's magnitude — a conversation
                // against an insult, roughly — keeps a bad act costly without making recovery
                // impossible.
                actor_to_target: (trust: 0.05),
                target_to_actor: (trust: 0.05),
            ),
            // A refusal is not an injury: the pack used to give it no outcome of its own, so the only
            // emotional consequence of being turned away was the crate's rejection distress — measured,
            // half of all the village's negativity. A refused greeting is mildly deflating, not a small
            // tragedy, and it is the definition's business to say so (OCC's *reproach*, mild).
            on_reject: (actor_emotion: Some((Distress, 0.1))),
            influence: ["kindness", "honesty"],
            barks: (
                actor: ["Morning, {target}!"],
                accepted: ["Good to see you, {target}."],
                rejected: ["Not now."],
            ),
        ),
        (
            id: "gossip",
            on_accept: (
                actor_needs: [("social", 0.15)],
                target_needs: [("social", 0.15)],
                // Listening to gossip is mildly agreeable for both: the teller is heard and the
                // listener is entertained. Same reasoning as `chat`.
                actor_emotion: Some((Liking, 0.15)),
                target_emotion: Some((Liking, 0.15)),
                // A little less than `chat`: sharing news is a weaker basis for trust than a conversation.
                actor_to_target: (trust: 0.03),
                target_to_actor: (trust: 0.03),
            ),
            on_reject: (actor_emotion: Some((Distress, 0.1))),
            gossip: true,
            barks: (
                actor: ["Did you hear about {subject}?"],
                accepted: ["Really? Tell me more."],
                rejected: ["I'd rather not."],
            ),
        ),
        (
            id: "compliment",
            on_accept: (
                target_to_actor: (affinity: 0.1, trust: 0.02),
                target_emotion: Some((Joy, 0.3)),
            ),
            barks: (
                actor: ["You look well, {target}."],
                accepted: ["Thank you!"],
                rejected: ["Hmm."],
            ),
        ),
        (
            id: "insult",
            on_accept: (target_emotion: Some((Anger, 0.5))),
            deed: Some("insult"),
            barks: (
                actor: ["Keep your distance, {target}."],
                accepted: ["How dare you!"],
                rejected: ["Hmph."],
            ),
        ),
    ],
)
